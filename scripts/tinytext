#!/usr/bin/env bash
# Command-line launcher.
#
#   tinytext file.txt
#
# Hands the given paths to the running app (or launches it) through
# LaunchServices, so files open as tabs in the existing window. This is why
# repeated invocations reuse one instance instead of starting a new process.
#
# Set TINYTEXT_APP to point at a bundle outside /Applications.
set -euo pipefail

APP="${TINYTEXT_APP:-/Applications/Tinytext.app}"

# Options are handled by the binary itself; `open` would treat them as files.
for arg in "$@"; do
    case "$arg" in
        --) break ;;
        -*) exec "$APP/Contents/MacOS/tinytext" "$@" ;;
    esac
done

if [ "${1:-}" = "--" ]; then
    shift
fi

if [ "$#" -eq 0 ]; then
    exec open -a "$APP"
fi

exec open -a "$APP" -- "$@"
